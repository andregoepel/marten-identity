<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Core">
    <PackageVersion Include="AndreGoepel.Core" Version="1.0.6" />
  </ItemGroup>

  <ItemGroup Label="Marten">
    <PackageVersion Include="Marten" Version="9.59.0" />
    <PackageVersion Include="Marten.AspNetCore" Version="9.59.0" />
    <PackageVersion Include="AndreGoepel.Marten.Configuration" Version="1.2.7" />
    <PackageVersion Include="AndreGoepel.Marten.Testing" Version="1.2.7" />
  </ItemGroup>

  <ItemGroup Label="Scheduling">
    <PackageVersion Include="Quartz.Extensions.Hosting" Version="4.7.3" />
  </ItemGroup>

  <ItemGroup Label="UI">
    <PackageVersion Include="AndreGoepel.Design.Blazor" Version="1.7.2" />
    <PackageVersion Include="Radzen.Blazor" Version="12.2.0" />
  </ItemGroup>

  <ItemGroup Label="E2E (browser-driven tests)">
    <PackageVersion Include="AndreGoepel.Testing.E2E" Version="1.3.5" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.6.5" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="AndreGoepel.Testing.Bunit" Version="1.3.5" />
    <PackageVersion Include="bunit" Version="2.15.2" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>
