<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Core">
    <PackageVersion Include="AndreGoepel.Core" Version="1.0.2" />
  </ItemGroup>

  <ItemGroup Label="Marten">
    <PackageVersion Include="Marten" Version="9.31.2" />
    <PackageVersion Include="Marten.AspNetCore" Version="9.31.2" />
    <PackageVersion Include="AndreGoepel.Marten.Configuration" Version="1.2.2" />
    <PackageVersion Include="AndreGoepel.Marten.Testing" Version="1.2.1" />
  </ItemGroup>

  <ItemGroup Label="Scheduling">
    <PackageVersion Include="Quartz.Extensions.Hosting" Version="3.20.0" />
  </ItemGroup>

  <ItemGroup Label="UI">
    <PackageVersion Include="AndreGoepel.Design.Blazor" Version="1.6.5" />
    <PackageVersion Include="Radzen.Blazor" Version="11.3.0" />
  </ItemGroup>

  <ItemGroup Label="E2E (browser-driven tests)">
    <PackageVersion Include="AndreGoepel.Testing.E2E" Version="1.3.1" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.5.3" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.62.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="AndreGoepel.Testing.Bunit" Version="1.3.1" />
    <PackageVersion Include="bunit" Version="2.9.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>
</Project>
