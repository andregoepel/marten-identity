<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Let a central PackageVersion override a transitive dependency's resolved
         version without a direct PackageReference (see SSH.NET pin below). -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Transitive security pins">
    <!-- AndreGoepel.Marten.Testing -> Testcontainers pulls SSH.NET 2025.1.0, which
         has a high severity arbitrary-file-write advisory (GHSA-q939-rpr3-3284).
         Pin to the patched 2026.0.0 to clear the CI vulnerability gate. Remove once
         Testcontainers resolves to >= 2026.0.0 on its own. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <ItemGroup Label="Core">
    <PackageVersion Include="AndreGoepel.Core" Version="1.0.1" />
  </ItemGroup>

  <ItemGroup Label="Marten">
    <PackageVersion Include="Marten" Version="9.23.0" />
    <PackageVersion Include="Marten.AspNetCore" Version="9.23.0" />
    <PackageVersion Include="AndreGoepel.Marten.Configuration" Version="1.1.0" />
    <PackageVersion Include="AndreGoepel.Marten.Testing" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup Label="Scheduling">
    <PackageVersion Include="Quartz.Extensions.Hosting" Version="3.19.1" />
  </ItemGroup>

  <ItemGroup Label="UI">
    <PackageVersion Include="AndreGoepel.Design.Blazor" Version="1.6.2" />
    <PackageVersion Include="Radzen.Blazor" Version="11.2.4" />
  </ItemGroup>

  <ItemGroup Label="E2E (browser-driven tests)">
    <PackageVersion Include="AndreGoepel.Testing.E2E" Version="1.0.0" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.4.6" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.62.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="bunit" Version="2.9.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>
</Project>
