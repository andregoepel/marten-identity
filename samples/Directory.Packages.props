<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Aspire (latest)">
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.6.3" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.3" />
    <!-- Keep Aspire's 2.x dependency line while patching GHSA-qhrr-8q5h-9q3h. -->
    <PackageVersion Include="MessagePack" Version="2.5.307" />
  </ItemGroup>

  <ItemGroup Label="Aspire service defaults (latest)">
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
  </ItemGroup>

  <ItemGroup Label="Web (kept in step with the libraries under /src)">
    <PackageVersion Include="AndreGoepel.Design.Blazor" Version="1.7.2" />
    <PackageVersion Include="Marten" Version="9.51.0" />
    <PackageVersion Include="Radzen.Blazor" Version="12.1.6" />
  </ItemGroup>
</Project>
